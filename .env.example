APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# local, public, s3, or wasabi (S3-compatible; set WASABI_* when using wasabi)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Communicator (https://sndng.co.za) — backup notifications when enabled (replaces default mail for those)
# COMMUNICATOR_ENABLED=true
# COMMUNICATOR_URL=https://sndng.co.za
# COMMUNICATOR_API_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Wasabi (S3-compatible). Set FILESYSTEM_DISK=wasabi and fill these after creating a bucket and access keys.
# Use the service URL from the Wasabi console for your region (e.g. https://s3.wasabisys.com for us-east-1).
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_DEFAULT_REGION=us-east-1
WASABI_BUCKET=
WASABI_ENDPOINT=
WASABI_URL=
WASABI_USE_PATH_STYLE_ENDPOINT=true

# Database backups to Wasabi (see config/database_backup.php). Comma-separated notify emails.
# DATABASE_BACKUP_DISK=wasabi
# DATABASE_BACKUP_PATH_PREFIX=database-backups
# DATABASE_BACKUP_COMPRESS=true
# DATABASE_BACKUP_NOTIFY_EMAILS="ops@example.com,backup@example.com"
# RECURRING_ORDERS_NOTIFY_EMAILS="ops@example.com,admin@example.com"
# RECURRING_ORDERS_SMS_TO="27817878984"
# Daily schedule (Forge: enable Scheduler on the server; use a queue worker if QUEUE_CONNECTION is not sync)
# DATABASE_BACKUP_SCHEDULE_ENABLED=true
# DATABASE_BACKUP_SCHEDULE_TIME=03:00
# DATABASE_BACKUP_TIMEOUT=3600
# If mysqldump cannot resolve DB_HOST (e.g. Unknown MySQL server host 'mysql'), try:
# DATABASE_BACKUP_MYSQL_HOST=host.docker.internal
# DATABASE_BACKUP_MYSQL_PORT=3306
# When using php artisan on the host (not sail), Docker hostnames are auto-mapped to 127.0.0.1 unless:
# DATABASE_BACKUP_DOCKER_HOST_FALLBACK=false

# Resource Intelligence PDF: browsershot (Chromium, matches browser layout) or dompdf (no Node/Chromium)
# WASTE_REPORT_PDF_DRIVER=browsershot
# WASTE_REPORT_PDF_FALLBACK_TO_DOMPDF=true
# BROWSERSHOT_NO_SANDBOX=true
# BROWSERSHOT_NODE_BINARY=
# BROWSERSHOT_NPM_BINARY=
# BROWSERSHOT_CHROME_PATH=
# BROWSERSHOT_PDF_DELAY_MS=500
# BROWSERSHOT_PDF_TIMEOUT=120
# BROWSERSHOT_PDF_WAIT_NETWORK_IDLE=false
# BROWSERSHOT_PDF_URL_DELAY_MS=4000

VITE_APP_NAME="${APP_NAME}"
